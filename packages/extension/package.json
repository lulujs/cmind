{
    "name": "vscode-cmind",
    "description": "CMind DSL language support for VS Code",
    "version": "0.0.1",
    "displayName": "CMind",
    "publisher": "cmind",
    "type": "module",
    "engines": {
        "vscode": "^1.67.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "cmind",
            "aliases": ["cmind", "cmind"],
            "extensions": [".cmind"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "cmind",
            "scopeName": "source.cmind",
            "path": "syntaxes/cmind.tmLanguage.json"
        }],
        "commands": [{
            "command": "cmind.convertToKityMinder",
            "title": "Convert to KityMinder KM",
            "category": "CMind"
        }],
        "menus": {
            "editor/context": [{
                "command": "cmind.convertToKityMinder",
                "when": "resourceExtname == .cmind",
                "group": "1_modification"
            }],
            "explorer/context": [{
                "command": "cmind.convertToKityMinder",
                "when": "resourceExtname == .cmind",
                "group": "1_modification"
            }]
        },
        "configuration": {
            "title": "CMind",
            "properties": {
                "cmind.autoConvertOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically convert CMind files to KityMinder KM when saved"
                },
                "cmind.outputDirectory": {
                    "type": "string",
                    "default": "",
                    "description": "Output directory for generated KityMinder KM files (empty = same directory as source)"
                },
                "cmind.showNotifications": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show notifications for conversion success and errors"
                }
            }
        }
    },
    "activationEvents": [
        "onLanguage:cmind",
        "onCommand:cmind.convertToKityMinder"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/cmind.tmLanguage.json ./syntaxes/cmind.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\"",
        "test": "vitest run"
    },
    "dependencies": {
        "cmind-language": "0.0.1",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "~1.67.0",
        "concurrently": "~8.2.1",
        "esbuild": "~0.25.5",
        "vitest": "~3.1.3",
        "fast-check": "^4.4.0"
    },
    "vsce": {
      "dependencies": false
    }
}
